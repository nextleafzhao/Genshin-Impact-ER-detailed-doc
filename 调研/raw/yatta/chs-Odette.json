ed":false,"prop":[{"id":3,"type":"normal"},{"id":4,"type":"normal"}]}},"4":{"skillId":15021,"type":2,"name":"获选者的春祭","description":"奥黛塔召唤{LINK#N11500001}<color=#FFD780FF>独舞倒影</color>{/LINK}时，还会获得4层{LINK#N11500003}<color=#FFD780FF>华彩</color>{/LINK}。","descriptionBuff":"","icon":"UI_Talent_S_Odette_05","effects":["N11500001","N11500003"],"linkedConstellations":{"isLevelIncluded":false,"prop":[{"id":0,"type":"normal"},{"id":1,"type":"normal"},{"id":5,"type":"normal"}]}},"5":{"skillId":15022,"type":2,"name":"赤忱者的悲歌","description":"基于奥黛塔攻击力超过1000点的部分，每100点攻击力都将使奥黛塔造成的星烁反应伤害额外造成原本1.5%的伤害，至多通过这种方式额外造成原本30%的伤害。","descriptionBuff":"","icon":"UI_Talent_S_Odette_06","linkedConstellations":null},"6":{"skillId":15023,"type":2,"name":"星耀祝礼·银晓之舞","description":"处于{LINK#N11330003}<color=#FFD780FF>极星辉域</color>{/LINK}中时/队伍中的角色在附近触发星扩散反应后的8秒内，奥黛塔将分别进入<color=#FFD780FF>辉映·星超导</color>/<color=#FFD780FF>辉映·星扩散</color>状态。\\n队伍中的角色触发超导/冰元素扩散反应时，将转为触发星超导/星扩散反应，且基于奥黛塔的攻击力，提升队伍中角色造成的上述反应的基础伤害：每100点攻击力都将提升0.7%上述反应的基础伤害，至多通过这种方式提升14%伤害。","descriptionBuff":"","icon":"UI_Talent_S_Odette_07","effects":["N11330003"],"linkedConstellations":null},"8":{"skillId":15025,"type":2,"name":"回响中的冬梦","description":"在小地图上显示周围的<color=#FFD780FF>至冬区域特产</color>的位置，在影域中亦能提供相同的佑助。\\n在闲暇时练习舞蹈，或许还会触发其他的效果…","descriptionBuff":"","icon":"UI_Talent_S_Odette_08","linkedConstellations":null}},"constellation":{"0":{"id":0,"talentId":1501,"name":"「不曾起舞的清晨，她望向倒影」","description":"施放特殊元素战技{LINK#N11500002}<color=#FFD780FF>柔板·破晓终奏</color>{/LINK}后，在共舞结束时，奥黛塔将对附近的敌人造成一次额外的<color=#99FFFFFF>冰元素范围伤害</color>，该伤害视为：\\n·<color=#FFD780FF>辉映·星超导</color>或不处于辉映状态：相当于奥黛塔攻击力300%的星超导反应伤害；\\n·<color=#FFD780FF>辉映·星扩散</color>：相当于奥黛塔攻击力450%的星扩散反应伤害。\\n\\n此外，突破天赋「获选者的春祭」获得强化：召唤{LINK#N11500001}<color=#FFD780FF>独舞倒影</color>{/LINK}时，奥黛塔将额外获得2层{LINK#N11500003}<color=#FFD780FF>华彩</color>{/LINK}，且奥黛塔处于队伍后台时，清除<color=#FFD780FF>华彩</color>的速度提升至每秒2层。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Odette_01","effects":["N11500002","N11500001","N11500003"]},"1":{"id":1,"talentId":1502,"name":"「她想，我要见证雪鹄未见之梦」","description":"突破天赋「获选者的春祭」获得强化：每层{LINK#N11500003}<color=#FFD780FF>华彩</color>{/LINK}还会使角色的攻击力提升7%。\\n此外，{LINK#N11500001}<color=#FFD780FF>独舞倒影</color>{/LINK}在场时，若奥黛塔处于{LINK#N11500004}<color=#FFD780FF>辉映·星烁</color>{/LINK}状态，<color=#FFD780FF>独舞倒影</color>附近敌人的对应元素抗性还会降低20%：\\n·<color=#FFD780FF>辉映·星超导</color>：<color=#99FFFFFF>冰元素</color>、<color=#FFACFFFF>雷元素</color>；\\n·<color=#FFD780FF>辉映·星扩散</color>：<color=#99FFFFFF>冰元素</color>、<color=#80FFD7FF>风元素</color>。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Odette_02","effects":["N11500003","N11500004","N11500001"]},"2":{"id":2,"talentId":1503,"name":"「我要追逐呼啸的风，向上独行」","description":"元素战技<color=#FFD780FF>{LINK#S11502}柔板·幻灵夜舞{/LINK}</color>的技能等级提高3级。\\n至多提升至15级。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Odette_01"},"3":{"id":3,"talentId":1504,"name":"「向上，坠往恍惚、燃烧的蓝空」","description":"元素爆发<color=#FFD780FF>疾板·苍羽一梦</color>获得强化：奥黛塔获得<color=#FFD780FF>雪鹄之梦</color>时，还会使队伍中附近的其他角色造成的星烁反应伤害提升，提升值相当于<color=#FFD780FF>雪鹄之梦</color>效果的50%。\\n\\n此外，队伍中的角色对敌人造成星烁反应伤害时，奥黛塔还会对敌人进行一次协同攻击，造成一次<color=#99FFFFFF>冰元素范围伤害</color>，每3.5秒至多触发一次，该伤害视为：\\n·<color=#FFD780FF>辉映·星超导</color>或不处于辉映状态：相当于奥黛塔攻击力66%的星超导反应伤害；\\n·<color=#FFD780FF>辉映·星扩散</color>：相当于奥黛塔攻击力99%的星扩散反应伤害。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Odette_03"},"4":{"id":4,"talentId":1505,"name":"「看呀，我已告别尘与土的苦痛」","description":"元素爆发<color=#FFD780FF>{LINK#S11505}疾板·苍羽一梦{/LINK}</color>的技能等级提高3级。\\n至多提升至15级。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_U_Odette_02"},"5":{"id":5,"talentId":1506,"name":"「伸出手，触及苍穹永恒的面容」","description":"突破天赋「获选者的春祭」获得强化：奥黛塔赋予队伍中附近的所有角色{LINK#N11500003}<color=#FFD780FF>华彩</color>{/LINK}时，自己的华彩不再会减少。\\n此外，处于<color=#FFD780FF>华彩</color>影响下的角色，对敌人造成的星烁反应伤害{LINK#N11190007}<color=#FFD780FF>擢升</color>{/LINK}25%，且奥黛塔对敌人造成的星烁反应伤害额外擢升20%。","descriptionBuff":null,"extraData":null,"icon":"UI_Talent_S_Odette_04","effects":["N11500003","N11190007"]}},"dictionary":{"talent":["N11500001","N11500002","N11500004","N11500003","N11330003"],"constellation":["N11500002","N11500001","N11500003","N11500004","N11190007"],"effectsInfo":{"N11500001":{"id":11500001,"name":"独舞倒影","description":"与奥黛塔一同起舞的心象倒影，可以通过施放元素战技或元素爆发召唤至场上。\\n会交替呈现<color=#FFD780FF>拂羽</color>与<color=#FFD780FF>旋翼</color>两种舞步，以优雅轻盈的舞姿间歇性攻击附近的敌人，造成<color=#99FFFFFF>冰元素范围伤害</color>。\\n同时至多存在一个奥黛塔自己创造的<color=#FFD780FF>独舞倒影</color>。\\n\\n此外，附近存在奥黛塔自己召唤的<color=#FFD780FF>独舞倒影</color>时，奥黛塔的元素战技<color=#FFD780FF>柔板·幻灵夜舞</color>将会被替换为特殊的元素战技<color=#FFD780FF>柔板·破晓终奏</color>。","params":null,"props":["","","","",""]},"N11500002":{"id":11500002,"name":"柔板·破晓终奏","description":"奥黛塔的特殊元素战技，对附近的敌人持续造成<color=#99FFFFFF>冰元素范围伤害</color>，并在共舞结束时，造成一次视为星超导反应伤害的<color=#99FFFFFF>冰元素范围伤害</color>。共舞时，奥黛塔可以控制舞步的方向。\\n<color=#FFD780FF>辉映·星烁</color>：共舞结束时，改为造成一次视为对应星烁反应伤害的<color=#99FFFFFF>冰元素范围伤害</color>。\\n\\n此外，施放特殊元素战技<color=#FFD780FF>柔板·破晓终奏</color>后，在<color=#FFD780FF>独舞倒影</color>剩余持续时间内，若奥黛塔处于<color=#FFD780FF>辉映·星烁</color>状态，则<color=#FFD780FF>独舞倒影</color>的两种舞步还会额外造成视为对应星烁反应伤害的<color=#99FFFFFF>冰元素范围伤害</color>。","params":null,"props":["","","","",""]},"N11500004":{"id":11500004,"name":"辉映·星烁","description":"<color=#FFD780FF>辉映·星超导</color>与<color=#FFD780FF>辉映·星扩散</color>统称为<color=#FFD780FF>辉映·星烁</color>状态。\\n角色同时只能受到一种辉映状态影响，且优先被<color=#FFD780FF>辉映·星超导</color>影响。","params":null,"props":["","","","",""]},"N11500003":{"id":11500003,"name":"华彩","description":"解锁突破天赋「获选者的春祭」后，奥黛塔召唤<color=#FFD780FF>独舞倒影</color>时将会获得的特殊效果。\\n每层<color=#FFD780FF>华彩</color>都会使角色造成的星烁反应伤害提升15%，持续至<color=#FFD780FF>独舞倒影</color>退场或重新召唤<color=#FFD780FF>独舞倒影</color>。\\n当奥黛塔处于队伍后台时，奥黛塔每秒会清除1层<color=#FFD780FF>华彩</color>，并使队伍中附近的其他角色获得对应层数的<color=#FFD780FF>华彩</color>。","params":null,"props":["0.15","1","","",""]},"N11330003":{"id":11330003,"name":"极星辉域","description":"触发星超导反应时，附近的区域会短暂变化为<color=#FFD780FF>极星辉域</color>；处于极星辉域中时，特定角色将会进入<color=#FFD780FF>辉映·星超导</color>状态，使其不同技能分别获得对应的强化效果。","params":null,"props":["","","","",""]},"N11190007":{"id":11190007,"name":"擢升","description":"特殊的伤害提升效果，与其他的伤害提升效果分别独立计算。","params":null,"props":["","","","",""]}}}}}